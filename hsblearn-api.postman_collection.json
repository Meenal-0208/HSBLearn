{
  "info": {
    "_postman_id": "hsblearn-api-collection-v1",
    "name": "HSBLearn API",
    "description": "Postman API Collection for HSBLearn AI-native LMS & Personal Study Space",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:9000/api",
      "type": "string"
    },
    {
      "key": "studentToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "instructorToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login as Student",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"student@hsblearn.local\",\n  \"password\": \"student123\"\n}"
            },
            "url": {"raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"]}
          }
        },
        {
          "name": "Login as Instructor",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"instructor@hsblearn.local\",\n  \"password\": \"instructor123\"\n}"
            },
            "url": {"raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"]}
          }
        },
        {
          "name": "Get Current User Profile",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{studentToken}}"}],
            "url": {"raw": "{{baseUrl}}/me", "host": ["{{baseUrl}}"], "path": ["me"]}
          }
        }
      ]
    },
    {
      "name": "Courses & Shared Classroom",
      "item": [
        {
          "name": "List Courses",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{studentToken}}"}],
            "url": {"raw": "{{baseUrl}}/courses", "host": ["{{baseUrl}}"], "path": ["courses"]}
          }
        },
        {
          "name": "Get Course Detail",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{studentToken}}"}],
            "url": {"raw": "{{baseUrl}}/courses/1", "host": ["{{baseUrl}}"], "path": ["courses", "1"]}
          }
        },
        {
          "name": "List Chapters",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{studentToken}}"}],
            "url": {"raw": "{{baseUrl}}/courses/1/chapters", "host": ["{{baseUrl}}"], "path": ["courses", "1", "chapters"]}
          }
        },
        {
          "name": "List Course Materials",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{studentToken}}"}],
            "url": {"raw": "{{baseUrl}}/courses/1/materials", "host": ["{{baseUrl}}"], "path": ["courses", "1", "materials"]}
          }
        }
      ]
    },
    {
      "name": "My Study Space",
      "item": [
        {
          "name": "List Personal Folders",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{studentToken}}"}],
            "url": {"raw": "{{baseUrl}}/study-space/folders", "host": ["{{baseUrl}}"], "path": ["study-space", "folders"]}
          }
        },
        {
          "name": "Create Personal Folder",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{studentToken}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Final Exam Preparation\"\n}"
            },
            "url": {"raw": "{{baseUrl}}/study-space/folders", "host": ["{{baseUrl}}"], "path": ["study-space", "folders"]}
          }
        },
        {
          "name": "List Personal Materials",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{studentToken}}"}],
            "url": {"raw": "{{baseUrl}}/study-space/materials", "host": ["{{baseUrl}}"], "path": ["study-space", "materials"]}
          }
        }
      ]
    },
    {
      "name": "AI Services",
      "item": [
        {
          "name": "Generate AI Study Notes",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{studentToken}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"material_ids\": [1],\n  \"note_style\": \"detailed\"\n}"
            },
            "url": {"raw": "{{baseUrl}}/ai/notes", "host": ["{{baseUrl}}"], "path": ["ai", "notes"]}
          }
        },
        {
          "name": "Generate Quick Revision Sheet",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{studentToken}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"material_ids\": [1]\n}"
            },
            "url": {"raw": "{{baseUrl}}/ai/revision-sheet", "host": ["{{baseUrl}}"], "path": ["ai", "revision-sheet"]}
          }
        },
        {
          "name": "Ask Grounded AI Tutor",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{studentToken}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"material_ids\": [1],\n  \"question\": \"Explain the core principles discussed.\"\n}"
            },
            "url": {"raw": "{{baseUrl}}/ai/ask", "host": ["{{baseUrl}}"], "path": ["ai", "ask"]}
          }
        },
        {
          "name": "Generate Quiz",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{studentToken}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"material_ids\": [1],\n  \"question_count\": 5,\n  \"question_types\": [\"mcq\"]\n}"
            },
            "url": {"raw": "{{baseUrl}}/ai/quizzes/generate", "host": ["{{baseUrl}}"], "path": ["ai", "quizzes", "generate"]}
          }
        },
        {
          "name": "YouTube Recommendations",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{studentToken}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"material_ids\": [1],\n  \"note_style\": \"concise\"\n}"
            },
            "url": {"raw": "{{baseUrl}}/ai/video-recommendations", "host": ["{{baseUrl}}"], "path": ["ai", "video-recommendations"]}
          }
        }
      ]
    },
    {
      "name": "Progress & Learning Activities",
      "item": [
        {
          "name": "Get Progress Summary",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{studentToken}}"}],
            "url": {"raw": "{{baseUrl}}/progress/summary", "host": ["{{baseUrl}}"], "path": ["progress", "summary"]}
          }
        },
        {
          "name": "Update Learning Activity",
          "request": {
            "method": "PUT",
            "header": [
              {"key": "Authorization", "value": "Bearer {{studentToken}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"activity_type\": \"read\",\n  \"status\": \"completed\",\n  \"material_id\": 1\n}"
            },
            "url": {"raw": "{{baseUrl}}/learning-activities", "host": ["{{baseUrl}}"], "path": ["learning-activities"]}
          }
        }
      ]
    }
  ]
}

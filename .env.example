# Server Configuration
PORT=9000
HOST=127.0.0.1
SECRET_KEY=change-this-in-production-to-a-secure-random-secret-key-32bytes

# AI Service Configuration (OpenAI compatible, Google Gemini, Anthropic, or custom endpoint)
# Supported LLM_PROVIDER options: mock, openai, gemini, anthropic
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=

# YouTube Data API v3
YOUTUBE_API_KEY=

# Uploads and Database Settings
UPLOAD_DIR=./uploads
DATABASE_PATH=./data/hsblearn.db
MAX_FILE_SIZE_MB=25
